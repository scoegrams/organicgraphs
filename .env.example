# --- Database ---
# Local dev uses the embedded PostgreSQL server started by `npm run db:start`.
# The embedded server listens on 55432 by default (see scripts/dev-db.mjs).
DATABASE_URL="postgresql://orggraph:orggraph@127.0.0.1:55432/orggraph?schema=public"

# If you prefer Docker, run `docker compose up -d db` and use:
# DATABASE_URL="postgresql://orggraph:orggraph@127.0.0.1:5432/orggraph?schema=public"

# --- Auth ---
# Signs the session cookie. Any long random string works in dev; production
# refuses to start unless this is at least 32 characters and not a placeholder.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-in-production-please-0123456789"

# --- AI provider ---
# Leave OPENAI_API_KEY empty to use the deterministic local mock provider.
# Set it to enable the OpenAI-backed intelligence provider.
AI_PROVIDER="deterministic"   # "deterministic" | "openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
